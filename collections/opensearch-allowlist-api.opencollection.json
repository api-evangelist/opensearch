{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenSearch Security Plugin REST Account Allowlist API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Allowlist",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get allowlist",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster-host}:9200/_plugins/_security/api/allowlist"
          },
          "docs": "Get allowlist"
        },
        {
          "info": {
            "name": "Replace allowlist",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{cluster-host}:9200/_plugins/_security/api/allowlist",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replace allowlist"
        },
        {
          "info": {
            "name": "Patch allowlist",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{cluster-host}:9200/_plugins/_security/api/allowlist",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Patch allowlist"
        }
      ]
    }
  ],
  "bundled": true
}