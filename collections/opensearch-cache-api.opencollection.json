{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenSearch Security Plugin REST Account Cache API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cache",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Flush security cache",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{cluster-host}:9200/_plugins/_security/api/cache"
          },
          "docs": "Flush security cache"
        }
      ]
    }
  ],
  "bundled": true
}